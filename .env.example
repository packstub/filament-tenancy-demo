APP_NAME="Packstub Tenancy Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Pre-fill the login form with demo@example.com / packstub-tenancy-demo and show a "Sign in as viewer" button (demo only).
DEMO_LOGIN_PREFILL=true

# The CENTRAL domain — login, onboarding, the tenant switcher live here.
# Tenants are served from {slug}.filament-tenancy-demo.test (wildcard
# subdomains: Laravel Herd/Valet resolve *.test automatically).
APP_URL=http://filament-tenancy-demo.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central database. With sqlite, tenant databases are created next to it as
# database/tenant{uuid}.sqlite. For Postgres/MySQL the same credentials are the
# template for tenant databases, so the user needs CREATE DATABASE (Postgres:
# the CREATEDB role attribute). Laravel Cloud injects DB_* for you.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tenancy_demo
# DB_USERNAME=postgres
# DB_PASSWORD=

# Hosted demo only: drop every tenant + database and re-seed every hour.
DEMO_RESET_SCHEDULE=false

# Sessions and auth stay in the CENTRAL database by design; the plugin sets
# the session cookie domain per host at runtime, so no SESSION_DOMAIN needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Provisioning (create DB → migrate → seed → mark ready) runs on the queue.
# `composer run dev` starts a worker; `php artisan db:seed` forces sync.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
